<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
  <head>
    <%- include('./partials/header'); -%>
    <title><%= title %></title>
  </head>
  <body>
    <%- include('./partials/navbar'); -%>
    <div class="container min-vh-100 py-4">
      <div class="p-5 bg-primary text-white text-left rounded mb-4">
        <h1><%=title%></h1>
      </div>

      <a href="<%= basePath %>/new" class="btn btn-primary mb-4">+ New Message</a>

      <% if (userPost.length === 0) { %>
        <div class="alert alert-info">No messages yet. Be the first to post!</div>
      <% } %>

      <div class="row g-3">
        <% userPost.forEach((element) => { %>
          <div class="col-12">
            <div class="card">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                  <div class="flex-grow-1 me-3">
                    <h5 class="card-title mb-1">
                      <i class="fa fa-user-circle"></i> <%= element.user %>
                    </h5>
                    <p class="card-text mb-1"><%= element.text %></p>
                    <small class="text-muted"><%= element.formattedDate %></small>
                  </div>
                  <div class="d-flex gap-2 flex-shrink-0">
                    <a
                      href="<%= basePath %>/edit/<%= element.messageId %>"
                      class="btn btn-warning btn-sm"
                    >Edit</a>
                    <form method="POST" action="<%= basePath %>/delete">
                      <input
                        type="hidden"
                        name="messageId"
                        value="<%= element.messageId %>"
                      />
                      <button class="btn btn-danger btn-sm" type="submit" onclick="return confirm('Delete this message?')">Delete</button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
    <%- include('./partials/footer'); -%>
  </body>
</html>
