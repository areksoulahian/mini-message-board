<!-- edit page -->
<html lang="en" data-bs-theme="dark">
  <head>
    <%- include('./partials/header'); -%>
    <title><%= title %></title>
  </head>
  <body>
    <%- include('./partials/navbar'); -%>
    <div class="container min-vh-100">
      <div class="p-5 bg-primary text-white text-left rounded">
        <h1>Edit Message</h1>
      </div>
      <br />
      <div class="card">
        <div class="card-body">
          <form
            method="POST"
            action="<%= basePath %>/edit/<%= userPost.messageId %>"
          >
            <div class="mb-3">
              <label for="user" class="form-label">Name</label>
              <input
                class="form-control"
                type="text"
                name="user"
                id="user"
                value="<%= userPost.user %>"
                required
              />
            </div>
            <div class="mb-3">
              <label for="text" class="form-label">Message</label>
              <textarea
                class="form-control"
                name="text"
                id="text"
                rows="3"
                required
              ><%= userPost.text %></textarea>
            </div>
            <div class="mb-3 text-muted small">
              Posted: <%= userPost.formattedDate || userPost.added %>
            </div>
            <input
              type="hidden"
              name="added"
              value="<%= userPost.added %>"
            />
            <input
              type="hidden"
              name="messageId"
              value="<%= userPost.messageId %>"
            />
            <button class="btn btn-primary" type="submit">Save</button>
          </form>
        </div>
      </div>
    </div>
    <%- include('./partials/footer'); -%>
  </body>
</html>
